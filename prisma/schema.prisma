  country      String?
  city         String?
  coachName    String  @map("coach_name")
  coachEmail   String  @map("coach_email")
  coachPhone   String? @map("coach_phone")
  federationId String? @map("federation_id")

  // JWT firmado 30 días — NUNCA retornar al organizador
  accessToken   String   @unique @map("access_token")
  accessExpires DateTime @map("access_expires")

  // "pending"|"approved"|"rejected"|"waitlist"
  status          String    @default("pending")
  approvedAt      DateTime? @map("approved_at")
  approvedBy      String?   @map("approved_by")
  rejectionReason String?   @map("rejection_reason") @db.Text

  // "unpaid"|"partial"|"paid"|"waived"
  paymentStatus   String    @default("unpaid") @map("payment_status")
  paymentRef      String?   @map("payment_ref")
  paymentProofUrl String?   @map("payment_proof_url") @db.Text // URL Cloudinary
  paymentNotes    String?   @map("payment_notes") @db.Text
  paidAt          DateTime? @map("paid_at")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  dojo       Dojo              @relation(fields: [dojoId], references: [id])
  athletes   ExternalAthlete[]

  @@index([tournamentId])
  @@index([dojoId])
  @@index([coachEmail])
  @@index([accessToken])
  @@map("external_clubs")
}

// ── Atletas de clubs externos ────────────────────────────────
model ExternalAthlete {
  id             String @id @default(cuid())
  tournamentId   String @map("tournament_id")
  dojoId         String @map("dojo_id") // dojo anfitrión — SIEMPRE
  externalClubId String @map("external_club_id")

  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  documentId  String?  @map("document_id") // NUNCA incluir en listas
  birthDate   DateTime @map("birth_date")
  gender      String // "M"|"F"
  nationality String? // código ISO "PA","CO","MX"
  weight      Float?
  beltColor   String?  @map("belt_color")
  fepakaId    String?  @map("fepaka_id")
  photoUrl    String?  @map("photo_url") @db.Text // URL Cloudinary

  // Calculado al guardar con calculateAgeGroup()
  ageGroup String? @map("age_group")

  // "pending"|"approved"|"rejected"|"withdrawn"
  status String @default("pending")

  waiverSigned   Boolean   @default(false) @map("waiver_signed")
  waiverSignedAt DateTime? @map("waiver_signed_at")
  waiverIp       String?   @map("waiver_ip")

  // QR de acreditación — solo cuando club.status=approved Y paymentStatus=paid|waived
  qrCode           String?   @unique @map("qr_code")
  accreditedAt     DateTime? @map("accredited_at")
  credentialSentAt DateTime? @map("credential_sent_at")
  kikenAt          DateTime? @map("kiken_at")

  // Bracket asignado post-aprobación (sin FK formal — solo referencia)
  bracketId String? @map("bracket_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tournament             Tournament                @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  dojo                   Dojo                      @relation(fields: [dojoId], references: [id])
  externalClub           ExternalClub              @relation(fields: [externalClubId], references: [id], onDelete: Cascade)
  categories             ExternalAthleteCategory[]
  tournamentParticipants TournamentParticipant[]

  @@index([tournamentId])
  @@index([dojoId])
  @@index([externalClubId])
  @@index([externalClubId, status])
  @@index([qrCode])
  @@map("external_athletes")
}

// ── Inscripciones por categoría de atleta externo ───────────
model ExternalAthleteCategory {
  id           String @id @default(cuid())
  tournamentId String @map("tournament_id")
  dojoId       String @map("dojo_id") // dojo anfitrión — SIEMPRE
  athleteId    String @map("athlete_id")

  // Sin FK formal en bracketId para no crear relación inversa en TournamentBracket legacy
  bracketId     String? @map("bracket_id")
  categoryLabel String  @map("category_label") // "Kumite Cadete -63kg Masculino"

  // "pending"|"approved"|"rejected"|"waitlist"|"withdrawn"
  status          String  @default("pending")
  rejectionReason String? @map("rejection_reason") @db.Text

  feeAmount     Float? @map("fee_amount")
  // "unpaid"|"paid"|"waived"
  paymentStatus String @default("unpaid") @map("payment_status")

  // Ranking/seeding
  isRanking        Boolean  @default(false) @map("is_ranking") // coach lo marca al inscribir
  rankingValidated Boolean? @map("ranking_validated") // null=pendiente, true/false=decisión
  rankingNote      String?  @map("ranking_note") @db.Text // coach: "Campeón Nac. 2024"
  rankingSeed      Int?     @map("ranking_seed") // organizador asigna: 1-4

  bracketSeed     Int? @map("bracket_seed")
  bracketPosition Int? @map("bracket_position")

  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by")

  athlete ExternalAthlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  bracket TournamentBracket? @relation(fields: [bracketId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([dojoId])
  @@index([athleteId])
  @@index([bracketId])
  @@map("external_athlete_categories")
}

// ── Hantei votes ─────────────────────────────────────────────
model HanteiVote {
  id           String @id @default(cuid())
  matchId      String @map("match_id")
  judgeId      String @map("judge_id")
  tournamentId String @map("tournament_id")
  dojoId       String @map("dojo_id") // SIEMPRE presente — isolación multi-tenant

  vote      String // "ao" | "aka"
  isReferee Boolean @default(false) @map("is_referee")
  // true = árbitro principal — su voto es el desempate en caso de empate 2-2

  votedAt DateTime @default(now()) @map("voted_at")

  @@unique([matchId, judgeId]) // un juez, un voto por combate
  @@index([matchId])
  @@index([tournamentId])
  @@index([dojoId])
  @@map("hantei_votes")
}

// ── Eventos del dojo ─────────────────────────────────────────
model Event {
  id          String   @id @default(cuid())
  dojoId      String   @map("dojo_id")
  dojo        Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  location    String?
  imageUrl    String?  @map("image_url") @db.Text
  price       Float?   @default(0) // null o 0 = gratis. Al confirmar asistencia con precio > 0 se genera un cargo pendiente en la cuenta del alumno.
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rsvps EventRSVP[]

  @@index([dojoId])
  @@index([dojoId, endDate])
  @@map("events")
}

// ── RSVP de eventos ──────────────────────────────────────────────────────────
model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("attending") // "attending" | "not_attending"
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, studentId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([studentId])
  @@map("event_rsvps")
}

// ── Tienda del dojo ──────────────────────────────────────────
model StoreProduct {
  id          String   @id @default(cuid())
  dojoId      String   @map("dojo_id")
  dojo        Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  price       Float
  currency    String   @default("USD")
  imageUrl    String?  @map("image_url") @db.Text
  sizes       Json? // string[] — ["XS","S","M","L","XL"] o null si no aplica
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchaseRequests StorePurchaseRequest[]

  @@index([dojoId])
  @@index([dojoId, active])
  @@map("store_products")
}

// Intención de compra enviada desde el portal del alumno — el dojo NO cobra
// en línea (sin pasarela alumno→dojo), coordina pago y entrega manualmente,
// igual que ya hace hoy con el CTA de WhatsApp de la página pública.
model StorePurchaseRequest {
  id        String       @id @default(cuid())
  dojoId    String       @map("dojo_id")
  dojo      Dojo         @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  productId String       @map("product_id")
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  studentId String       @map("student_id")
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  size      String?
  notes     String?      @db.Text
  status    String       @default("PENDING") // PENDING | CONTACTED | COMPLETED | CANCELLED
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([dojoId, status])
  @@index([studentId])
  @@map("store_purchase_requests")
}

// ════════════════════════════════════════════════════════════════════════════
// MÓDULO ASISTENCIA A TORNEOS — independiente de Torneo Pro y de asistencia
// diaria. dojoId y studentId son strings sin FK formal para no modificar
// modelos existentes. Aislamiento multi-tenant enforced en las APIs.
// ════════════════════════════════════════════════════════════════════════════

model TournamentEvent {
  id            String   @id @default(cuid())
  dojoId        String   @map("dojo_id") // dojo propietario — SIEMPRE presente
  name          String // nombre del torneo
  date          DateTime // fecha del evento
  location      String // sede/lugar
  notes         String?  @db.Text
  sourceEventId String?  @map("source_event_id") // Event.id de origen si se generó con "Crear Lista de Asistencia" — sin FK formal, no modifica Event
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  participants TournamentEventParticipant[]

  @@index([dojoId])
  @@index([dojoId, date])
  @@index([sourceEventId])
  @@map("tournament_events")
}

model TournamentEventParticipant {
  id        String @id @default(cuid())
  eventId   String @map("event_id")
  studentId String @map("student_id") // sin FK formal — no modifica Student

  // ── Asistencia ─────────────────────────────────────────────────
  arrived   Boolean   @default(false)
  arrivedAt DateTime? @map("arrived_at")
  scannedBy String?   @map("scanned_by") // nombre del usuario que escaneó

  // ── Resultados ─────────────────────────────────────────────────
  category         String? @map("category") // categoría de competencia (ej: "Cadete -57kg")
  kataName         String? @map("kata_name") // kata ejecutado
  kataResult       String? @map("kata_result") // ej: "1° Lugar", "Medalla de Oro"
  kumiteResult     String? @map("kumite_result") // ej: "Medalla de Bronce"
  competitionNotes String? @map("competition_notes") @db.Text

  // IDs de los registros en KataCompetition (para actualizar en lugar de duplicar)
  kataCompetitionId   String? @map("kata_competition_id")
  kumiteCompetitionId String? @map("kumite_competition_id")

  // ── Confirmación previa al evento ──────────────────────────────
  confirmed Boolean @default(false) @map("confirmed")

  // ── Rechazo de participación ────────────────────────────────────
  optedOut       Boolean @default(false) @map("opted_out")
  optedOutReason String? @map("opted_out_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event TournamentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([eventId])
  @@index([studentId])
  @@index([eventId, arrived])
  @@index([eventId, kataResult])
  @@map("tournament_event_participants")
}

// ════════════════════════════════════════════════════════════════════════════
// AUTO-REGISTRO — Links de auto-inscripción + cola de aprobación
// ════════════════════════════════════════════════════════════════════════════

model RegistrationLink {
  id          String    @id @default(cuid())
  dojoId      String    @map("dojo_id")
  dojo        Dojo      @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  token       String    @unique // crypto.randomUUID() — 122 bits de entropía
  label       String // "Inscripciones Enero 2026"
  isActive    Boolean   @default(true) @map("is_active")
  activatesAt DateTime? @map("activates_at") // no usable ANTES de esta fecha
  expiresAt   DateTime? @map("expires_at") // no usable DESPUÉS de esta fecha
  maxUses     Int?      @map("max_uses") // null = sin límite
  useCount    Int       @default(0) @map("use_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by") // userId del admin

  pendingStudents PendingStudent[]

  @@index([dojoId])
  @@map("registration_links")
}

model PendingStudent {
  id                 String           @id @default(cuid())
  dojoId             String           @map("dojo_id")
  dojo               Dojo             @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  registrationLinkId String           @map("registration_link_id")
  registrationLink   RegistrationLink @relation(fields: [registrationLinkId], references: [id], onDelete: Cascade)

  // ── Datos personales ────────────────────────────────────────
  fullName    String   @map("full_name")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  birthDate   DateTime @map("birth_date")
  gender      String
  nationality String
  cedula      String?
  fepakaId    String?  @map("fepaka_id")
  ryoBukaiId  String?  @map("ryo_bukai_id")

  // ── Datos de salud ──────────────────────────────────────────
  bloodType           String? @map("blood_type")
  condition           String?
  hasPrivateInsurance Boolean @default(false) @map("has_private_insurance")
  insuranceName       String? @map("insurance_name")
  insuranceNumber     String? @map("insurance_number")

  // ── Contactos ───────────────────────────────────────────────
  motherName  String? @map("mother_name")
  motherPhone String? @map("mother_phone")
  motherEmail String? @map("mother_email")
  fatherName  String? @map("father_name")
  fatherPhone String? @map("father_phone")
  fatherEmail String? @map("father_email")
  address     String? @db.Text
  photo       String? @db.Text // base64 — se copia a Student al aprobar

  // ── Contexto familiar ───────────────────────────────────────
  hasSiblingInDojo Boolean @default(false) @map("has_sibling_in_dojo")
  primaryGuardian  String? @map("primary_guardian") // "mother" | "father" — acudiente principal para acceso al portal

  // Consentimiento de WhatsApp capturado en el registro público — se copia
  // explícitamente a Student al aprobar (ver pending-students/[id]/approve).
  whatsappOptIn Boolean @default(false) @map("whatsapp_opt_in")

  // ── Control de aprobación ───────────────────────────────────
  status        String    @default("pending") // pending | approved | rejected
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  rejectionNote String?   @map("rejection_note")
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  submitterIp   String?   @map("submitter_ip")
  resetToken    String?   @unique @map("reset_token") // token de un solo uso para re-envío autorizado por admin

  // Versión de los términos que aceptó al registrarse (null = usó contractPolicy antiguo)
  acceptedTermsVersion Int? @map("accepted_terms_version")

  @@index([dojoId, status])
  @@index([registrationLinkId])
  @@map("pending_students")
}

// ════════════════════════════════════════════════════════════════════════════
// BILLING — Planes, Suscripciones y Facturas
// ════════════════════════════════════════════════════════════════════════════

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  READ_ONLY
  COMPLIMENTARY // acceso completo permanente sin pago
  SPECIAL_ACCESS // acceso especial con fecha de expiración configurable
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentGateway {
  PAYPAL
  MERCADOPAGO
  PAGUELOFACIL
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PagueloFacilLinkStatus {
  PENDING // link generado, esperando pago
  PAID // confirmado y validado server-side
  EXPIRED // venció EXPIRES_IN sin pago
  FAILED // rechazado o monto/firma inválidos
  USED // ya consumido — protege contra replay del RETURN_URL
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  monthlyPrice    Float    @map("monthly_price")
  annualPrice     Float    @map("annual_price")
  maxStudents     Int?     @map("max_students")
  features        String // JSON array de strings — texto de marketing, NO controla acceso
  featureKeys     String?  @map("feature_keys") // JSON array de NavKey — null = plan legado, sin restricción (compatibilidad)
  isActive        Boolean  @default(true) @map("is_active")
  paypalProductId String?  @map("paypal_product_id")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  dojoId               String             @unique @map("dojo_id")
  dojo                 Dojo               @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  planId               String             @map("plan_id")
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIAL)
  cycle                BillingCycle       @default(MONTHLY)
  trialEndsAt          DateTime           @map("trial_ends_at")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  gateway              PaymentGateway?
  paypalSubscriptionId String?            @map("paypal_subscription_id")
  paypalCustomerId     String?            @map("paypal_customer_id")
  mpSubscriptionId     String?            @map("mp_subscription_id")
  mpCustomerId         String?            @map("mp_customer_id")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  // Acceso especial otorgado por sysadmin
  grantedBy            String?            @map("granted_by") // email del sysadmin
  grantedAt            DateTime?          @map("granted_at") // fecha del otorgamiento
  grantNote            String?            @map("grant_note") // motivo/nota interna
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([status])
  @@index([trialEndsAt])
  @@map("subscriptions")
}

model Invoice {
  id               String         @id @default(cuid())
  subscriptionId   String         @map("subscription_id")
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dojoId           String         @map("dojo_id")
  amount           Float
  currency         String         @default("USD")
  status           InvoiceStatus  @default(PENDING)
  gateway          PaymentGateway
  gatewayInvoiceId String?        @map("gateway_invoice_id")
  paidAt           DateTime?      @map("paid_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  pagueloFacilTransactions PagueloFacilTransaction[]

  @@index([subscriptionId])
  @@index([dojoId])
  @@index([status])
  @@map("invoices")
}

// PagueloFacil — Enlace de Pago. Un Invoice puede tener varios intentos
// (attemptId distinto) si un link expira y se regenera sobre el mismo ciclo.
model PagueloFacilTransaction {
  id             String                 @id @default(cuid())
  invoiceId      String                 @map("invoice_id")
  invoice        Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dojoId         String                 @map("dojo_id") // sin @relation — mismo patrón que AuditLog
  linkCode       String                 @unique @map("link_code") // "LK-..." devuelto por PagueloFacil
  cclw           String // código web del comercio usado en la solicitud
  amountExpected Float                  @map("amount_expected")
  amountPaid     Float?                 @map("amount_paid")
  status         PagueloFacilLinkStatus @default(PENDING)
  environment    String // "sandbox" | "production"
  signedToken    String                 @map("signed_token") // HMAC atado a este intento (invoiceId+dojoId+linkCode)
  attemptId      String                 @map("attempt_id") // determinístico — protege reintentos del cron
  expiresAt      DateTime               @map("expires_at")
  rawResponse    Json?                  @map("raw_response") // payload crudo de confirmación, para auditoría
  createdAt      DateTime               @default(now()) @map("created_at")
  confirmedAt    DateTime?              @map("confirmed_at")

  @@unique([invoiceId, attemptId])
  @@index([dojoId])
  @@index([status])
  @@map("paguelofacil_transactions")
}

// Log de correos de aviso de vencimiento de acceso especial
model SpecialAccessEmailLog {
  id       String   @id @default(cuid())
  dojoId   String   @map("dojo_id")
  dojo     Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  email    String
  daysLeft Int      @map("days_left")
  status   String // "sent" | "failed"
  error    String?
  sentAt   DateTime @default(now()) @map("sent_at")

  @@index([dojoId])
  @@index([sentAt])
  @@map("special_access_email_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// MÓDULO EXÁMENES Y CERTIFICADOS
// ════════════════════════════════════════════════════════════════════════════

model ExamApplication {
  id            String    @id @default(cuid())
  dojoId        String    @map("dojo_id")
  title         String
  location      String
  examDate      DateTime  @map("exam_date")
  examTime      String    @map("exam_time")
  deadline      DateTime?
  amount        Float     @default(0)
  description   String?   @db.Text
  imageUrl      String?   @map("image_url") @db.Text
  imagePublicId String?   @map("image_public_id")
  status        String    @default("DRAFT")
  archivedAt    DateTime? @map("archived_at")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  dojo             Dojo                          @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  invitees         ExamApplicationInvitee[]
  evaluationLinks  EvaluationLink[]

  @@index([dojoId, status])
  @@index([dojoId, examDate])
  @@index([dojoId, archivedAt])
  @@map("exam_applications")
}

model ExamApplicationInvitee {
  id            String    @id @default(cuid())
  applicationId String    @map("application_id")
  studentId     String    @map("student_id")
  beltToPresent String    @map("belt_to_present")
  response      String    @default("PENDING")
  responseNote  String?   @map("response_note") @db.Text
  respondedAt   DateTime? @map("responded_at")
  paymentStatus String    @default("PENDING") @map("payment_status")
  paidAt        DateTime? @map("paid_at")
  attended      Boolean   @default(false)
  passed        Boolean?
  finalScore    Float?    @map("final_score") // calculado a partir de ExamScore — nunca editado a mano
  // Idempotencia para permitir Reabrir + volver a Finalizar sin duplicar
  // efectos ya aplicados a quienes se procesaron en una corrida anterior.
  beltAwarded      Boolean   @default(false) @map("belt_awarded")
  resultNotifiedAt DateTime? @map("result_notified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  application ExamApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  certificate GeneratedCertificate?
  scores      ExamScore[]

  @@unique([applicationId, studentId])
  @@index([studentId])
  @@index([applicationId, response])
  @@map("exam_application_invitees")
}

// ── Evaluación (Senseis, criterios y notas) ──────────────────────────────
// Módulo independiente de Postulaciones: el admin configura una Evaluación
// (criterios + Senseis) una sola vez y "llama" (vincula) una o varias
// Postulaciones existentes para traer a sus postulados aceptados como
// candidatos — así no hay que repetir la configuración por cada examen, y
// una misma Evaluación puede combinar postulados de varias Postulaciones.
// Un Sensei entra por su propio link (token, sin cuenta de usuario — mismo
// patrón que RegistrationLink) y solo ve/califica a los postulados
// aceptados de las Postulaciones vinculadas. No ve las notas de otros Senseis.

model Evaluation {
  id        String   @id @default(cuid())
  dojoId    String   @map("dojo_id")
  dojo      Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  criteria   ExamCriteria[]
  evaluators ExamEvaluator[]
  links      EvaluationLink[]

  @@index([dojoId])
  @@map("evaluations")
}

// Postulación "llamada" a una Evaluación — sus postulados con response=ACCEPTED
// pasan a ser candidatos de la Evaluación.
model EvaluationLink {
  id           String   @id @default(cuid())
  evaluationId String   @map("evaluation_id")
  applicationId String  @map("application_id")
  // Cintas de esta Postulación que en verdad pertenecen a esta Evaluación —
  // permite "llamar" la misma Postulación (con alumnos de varias cintas) a
  // distintas Evaluaciones (una por franja horaria/grupo de cinta) sin que
  // se mezclen. Array vacío = todas las cintas de la Postulación (comportamiento
  // histórico, retro-compatible con los vínculos creados antes de este campo).
  beltFilter   String[] @default([]) @map("belt_filter")
  createdAt    DateTime @default(now()) @map("created_at")

  evaluation  Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  application ExamApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, applicationId])
  @@index([applicationId])
  @@map("evaluation_links")
}

model ExamCriteria {
  id           String @id @default(cuid())
  evaluationId String @map("evaluation_id")
  name         String // "Kihon", "Kata"...
  weightPct    Float  @map("weight_pct") // el conjunto de criterios de una evaluación debe sumar 100
  order        Int    @default(0)

  evaluation Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  scores     ExamScore[]

  @@index([evaluationId])
  @@map("exam_criteria")
}

model ExamEvaluator {
  id           String    @id @default(cuid())
  evaluationId String    @map("evaluation_id")
  name         String // sin cuenta de usuario — el Sensei solo confirma su nombre al entrar
  token        String    @unique // crypto.randomUUID()
  active       Boolean   @default(true) // se desactiva al cerrar la evaluación
  confirmedAt  DateTime? @map("confirmed_at") // primera vez que validó su nombre
  createdAt    DateTime  @default(now()) @map("created_at")

  evaluation Evaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  scores     ExamScore[]

  @@index([evaluationId])
  @@map("exam_evaluators")
}

model ExamScore {
  id          String   @id @default(cuid())
  inviteeId   String   @map("invitee_id")
  criteriaId  String   @map("criteria_id")
  evaluatorId String   @map("evaluator_id")
  value       Float // escala 0-10
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invitee   ExamApplicationInvitee @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  criteria  ExamCriteria           @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  evaluator ExamEvaluator          @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([inviteeId, criteriaId, evaluatorId])
  @@index([inviteeId])
  @@index([evaluatorId])
  @@map("exam_scores")
}

model CertificateTemplate {
  id            String   @id @default(cuid())
  dojoId        String   @map("dojo_id")
  name          String
  imageUrl      String   @map("image_url") @db.Text
  imagePublicId String   @map("image_public_id")
  canvasWidth   Int      @default(1000) @map("canvas_width")
  canvasHeight  Int      @default(700) @map("canvas_height")
  elements      Json
  active        Boolean  @default(true) // false = eliminada (soft-delete), no implica "en uso"
  // La plantilla que se usa para emitir diplomas al finalizar un examen —
  // una sola por dojo a la vez (se reasigna al crear una nueva o al elegir
  // "usar esta plantilla" en Configuración > Certificados).
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dojo         Dojo                   @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  certificates GeneratedCertificate[]

  @@index([dojoId, active])
  @@map("certificate_templates")
}

model GeneratedCertificate {
  id             String    @id @default(cuid())
  dojoId         String    @map("dojo_id")
  studentId      String    @map("student_id")
  inviteeId      String?   @unique @map("invitee_id")
  templateId     String    @map("template_id")
  title          String
  beltColor      String    @map("belt_color")
  issuedDate     DateTime  @map("issued_date")
  instructorName String?   @map("instructor_name")
  pdfUrl         String?   @map("pdf_url") @db.Text
  pdfPublicId    String?   @map("pdf_public_id")
  status         String    @default("DRAFT")
  revokedReason  String?   @map("revoked_reason") @db.Text
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  dojo     Dojo                    @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  student  Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invitee  ExamApplicationInvitee? @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  template CertificateTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([dojoId, status])
  @@index([dojoId, beltColor])
  @@index([dojoId, createdAt])
  @@map("generated_certificates")
}

// ── Políticas y Términos del Dojo ────────────────────────────────────────────

model DojoTermsPolicy {
  id        String   @id @default(cuid())
  dojoId    String   @unique @map("dojo_id")
  content   String   @db.Text
  version   Int      @default(1)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  dojo Dojo @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  @@map("dojo_terms_policies")
}

model TermsAcceptance {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  dojoId     String   @map("dojo_id")
  version    Int
  acceptedAt DateTime @default(now()) @map("accepted_at")
  ipAddress  String?  @map("ip_address")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dojo    Dojo    @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  @@unique([studentId, dojoId])
  @@index([dojoId])
  @@map("terms_acceptances")
}

// ── Notificaciones Push (Web Push / VAPID) ────────────────────────────────────

model PushSubscription {
  id          String    @id @default(cuid())
  dojoId      String    @map("dojo_id")
  studentId   String?   @map("student_id") // null si es admin/user
  userId      String?   @map("user_id") // null si es student
  endpoint    String    @unique @db.Text
  p256dh      String    @db.Text
  auth        String    @db.Text
  deviceLabel String?   @map("device_label")
  userAgent   String?   @map("user_agent") @db.Text
  active      Boolean   @default(true)
  failCount   Int       @default(0) @map("fail_count")
  lastSentAt  DateTime? @map("last_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  dojo    Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dojoId])
  @@index([dojoId, active])
  @@index([studentId])
  @@index([userId])
  @@map("push_subscriptions")
}

model PushNotificationLog {
  id           String   @id @default(cuid())
  dojoId       String   @map("dojo_id")
  type         String // manual | attendance | payment | birthday | video | event | exam_published | exam_result | exam_deadline
  title        String
  body         String   @db.Text
  url          String?
  targetCount  Int      @default(0) @map("target_count")
  successCount Int      @default(0) @map("success_count")
  failCount    Int      @default(0) @map("fail_count")
  sentBy       String?  @map("sent_by") // userId de quien envió (null si fue automático)
  sentAt       DateTime @default(now()) @map("sent_at")

  dojo Dojo @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  @@index([dojoId, sentAt])
  @@map("push_notification_logs")
}

model VisitorLog {
  id          String   @id @default(cuid())
  ip          String
  country     String?
  countryCode String?  @map("country_code")
  city        String?
  region      String?
  lat         String?
  lng         String?
  path        String
  userAgent   String?  @map("user_agent") @db.Text
  referer     String?
  visitedAt   DateTime @default(now()) @map("visited_at")

  @@index([visitedAt])
  @@index([countryCode])
  @@map("visitor_logs")
}

model PushSettings {
  id                    String  @id @default(cuid())
  dojoId                String  @unique @map("dojo_id")
  enabled               Boolean @default(true)
  notifyAttendance      Boolean @default(true) @map("notify_attendance")
  notifyPaymentReminder Boolean @default(true) @map("notify_payment_reminder")
  notifyNewVideo        Boolean @default(true) @map("notify_new_video")
  notifyNewEvent        Boolean @default(true) @map("notify_new_event")
  notifyBirthday        Boolean @default(true) @map("notify_birthday")
  notifyExamPublished   Boolean @default(true) @map("notify_exam_published")
  notifyExamResult      Boolean @default(true) @map("notify_exam_result")
  notifyExamDeadline    Boolean @default(true) @map("notify_exam_deadline")

  dojo Dojo @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  @@map("push_settings")
}

// ── Novedades del sistema — publicadas por sysadmin para todos los dojos ────
model SystemNews {
  id            String   @id @default(cuid())
  version       String // "v2.4" | "Julio 2026"
  title         String // "Actualización de verano"
  items         Json // [{text, category}]
  audience      String   @default("all") // "all" | "admins" | "students"
  targetDojoId  String?  @map("target_dojo_id") // null = todos los dojos; si tiene valor, solo ese dojo
  status        String   @default("published") // "draft" | "published"
  testUserEmail String?  @map("test_user_email") // correo que ve el borrador
  publishedAt   DateTime @default(now()) @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@index([status, publishedAt])
  @@map("system_news")
}

// ════════════════════════════════════════════════════════════════════════════
// WHATSAPP — Notificaciones vía Meta Cloud API (Business Platform)
// ════════════════════════════════════════════════════════════════════════════

enum WhatsAppNotificationType {
  INVOICE // reservado — factura mensual con PDF adjunto, fase futura
  PAYMENT_OVERDUE
  PAYMENT_CONFIRMED
  TOURNAMENT_QR // reservado — acreditación de torneo, fase futura
  DOJO_DELINQUENCY_SUMMARY // resumen de mora mensual al admin del dojo — sin studentId/paymentId, dojoId + Dojo.phone
}

enum WhatsAppNotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppNotification {
  id     String @id @default(cuid())
  dojoId String @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  studentId String?  @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  paymentId String?  @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Reservado para TOURNAMENT_QR (fase futura) — sin FK todavía, se agrega
  // cuando se implemente esa etapa para no acoplar este modelo de antemano.
  tournamentRegistrationId String? @map("tournament_registration_id")

  recipientPhone String                     @map("recipient_phone") // E.164
  type           WhatsAppNotificationType
  templateName   String                     @map("template_name")
  templateVars   Json                       @map("template_vars")
  status         WhatsAppNotificationStatus @default(PENDING)
  metaMessageId  String?                    @unique @map("meta_message_id")
  errorDetail    String?                    @map("error_detail") @db.Text

  // fileId del recibo PDF subido a ImageKit (folder "receipts") como header
  // de confirmacion_pago_dojomaster. Se limpia (ImageKit + este campo a null)
  // por /api/cron/whatsapp-receipt-cleanup pasados los días de retención.
  receiptPublicId String? @map("receipt_public_id")

  // Cuántas veces se mandó de verdad (Meta confirmó éxito) para este pago+tipo.
  // Tope real de reenvío = 2 — se incrementa solo en un envío exitoso, nunca
  // en reintentos fallidos ni en la fila PENDING previa a llamar a Meta.
  sendCount Int @default(0) @map("send_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // La unicidad sigue existiendo (una sola fila por pago+tipo, se sobreescribe
  // en cada reintento) pero ya NO es la idempotencia real — eso ahora lo
  // decide sendCount (máximo 2 envíos exitosos).
  @@unique([paymentId, type])
  @@index([dojoId])
  @@map("whatsapp_notifications")
}

model WhatsAppInboundMessage {
  id            String   @id @default(cuid())
  fromPhone     String   @map("from_phone")
  metaMessageId String   @unique @map("meta_message_id")
  type          String
  text          String?  @db.Text
  receivedAt    DateTime @map("received_at")

  // Match best-effort por teléfono contra motherPhone/fatherPhone — null si no
  // hubo match único (0 o varios alumnos con ese teléfono, posible entre dojos).
  studentId String?  @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  dojoId    String?  @map("dojo_id")
  dojo      Dojo?    @relation(fields: [dojoId], references: [id], onDelete: SetNull)

  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([dojoId, handled])
  @@map("whatsapp_inbound_messages")
}
