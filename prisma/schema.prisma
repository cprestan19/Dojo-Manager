// Schema: DojoManager — SaaS de gestión de dojos de karate
// Desarrollado por Cristhian Paul Prestán — 2025

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Dojo {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?  @db.Text
  ownerName String?
  phone     String?
  slogan    String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Consentimiento para los mensajes de WhatsApp del CRM de activación
  // (DojoLifecycleMessage). Default true: el teléfono es obligatorio al
  // registrarse, decisión de negocio del dueño de la plataforma de tratar
  // eso como consentimiento implícito. Se apaga manual o automáticamente
  // si el dueño del dojo responde algo tipo "detener"/"stop" (ver
  // handleIncomingMessage en src/lib/whatsapp/webhookHandlers.ts).
  whatsappOptIn      Boolean   @default(true) @map("whatsapp_opt_in")
  whatsappOptOutDate DateTime? @map("whatsapp_opt_out_date")

  // Cliente destacado en la landing (barra de logos "confían en nosotros")
  featured Boolean @default(false)

  // Logo mostrado en esa vitrina — imagen independiente subida por el sysadmin,
  // NO es el logo real del dojo (Dojo.logo). Editarla nunca toca la marca del
  // cliente. La vitrina solo muestra dojos con featured=true Y featuredLogo seteado.
  featuredLogo String? @map("featured_logo") @db.Text

  // Parámetros de recordatorios de pago
  reminderToleranceDays Int     @default(5)
  lateInterestPct       Float   @default(10.0)
  autoRemindersEnabled  Boolean @default(false)

  // Tolerancia de tardanzas en asistencia (minutos después del inicio de clase)
  lateToleranceMinutes Int @default(10) @map("late_tolerance_minutes")

  // Visibilidad de campos específicos de organización (FEPAKA/Ryo Bukai) —
  // apagados por defecto en dojos nuevos, ya que son propios de federaciones
  // panameñas puntuales y no aplican a todos los dojos. Se activan solos vía
  // script para los dojos que ya tenían datos guardados ahí antes de que
  // existiera este interruptor (ver migrate-legacy-field-visibility).
  showFepakaField   Boolean @default(false) @map("show_fepaka_field")
  showRyoBukaiField Boolean @default(false) @map("show_ryo_bukai_field")

  // Zona horaria IANA del dojo (ej. "America/Panama", "America/Caracas") — determina
  // cómo se muestran e interpretan todas las fechas/horas del dojo (asistencia,
  // eventos, exámenes, postulaciones, recordatorios, etc.)
  timezone String @default("America/Panama") @map("timezone")

  // Moneda ISO 4217 en la que el alumno paga (mensualidades, tienda, exámenes,
  // inscripciones a torneo). El símbolo se deriva automáticamente del código —
  // nunca se guarda aparte. No afecta la facturación del dojo hacia DojoManager
  // (Plan/Subscription/Invoice), que siempre es en USD.
  currency String @default("USD") @map("currency")

  loginBgImage   String? @map("login_bg_image") @db.Text
  contractPolicy String? @map("contract_policy") @db.Text // texto de políticas/contrato mostrado en el auto-registro
  instagramUrl   String? @map("instagram_url")
  themeId        String  @default("dark-saas") @map("theme_id")
  locale         String  @default("es") @map("locale") // "es" | "en"
  tournamentPro  Boolean @default(false) @map("tournament_pro") // Módulo Torneo Pro activado

  // Colores de marca para el carnet digital del alumno (hex). null = paleta roja/negra por defecto.
  cardPrimaryColor   String? @map("card_primary_color")
  cardSecondaryColor String? @map("card_secondary_color")
  cardTertiaryColor  String? @map("card_tertiary_color")
  cardTemplateImage  String? @map("card_template_image") @db.Text
  cardLayout         Json?   @map("card_layout")
  cardLayout2        Json?   @map("card_layout_2")
  cardTemplateImage2 String? @map("card_template_image_2") @db.Text
  cardLayout3        Json?   @map("card_layout_3")
  cardTemplateImage3 String? @map("card_template_image_3") @db.Text
  activeCardSlot     Int     @default(1) @map("active_card_slot")

  users                   User[]
  students                Student[]
  katas                   Kata[]
  schedules               Schedule[]
  beltVideos              BeltVideo[]
  rolePermissions         DojoRolePermission[]
  dojoPage                DojoPage?
  freeTrials              FreeTrialRequest[]
  lifecycleMessages       DojoLifecycleMessage[]
  tournaments             Tournament[]
  tournamentTatamis       TournamentTatami[]
  tournamentJudges        TournamentJudge[]
  tournamentScheduleSlots TournamentScheduleSlot[]
  tournamentStreams       TournamentStream[]
  tournamentRegistrations TournamentRegistration[]
  events                  Event[]
  storeProducts           StoreProduct[]
  storePurchaseRequests   StorePurchaseRequest[]
  organizations           DojoOrganization[]
  externalClubs           ExternalClub[]
  externalAthletes        ExternalAthlete[]
  subscription            Subscription?
  registrationLinks       RegistrationLink[]
  pendingStudents         PendingStudent[]
  specialAccessEmailLogs  SpecialAccessEmailLog[]
  examApplications        ExamApplication[]
  certificateTemplates    CertificateTemplate[]
  generatedCertificates   GeneratedCertificate[]
  termsPolicy             DojoTermsPolicy?
  termsAcceptances        TermsAcceptance[]
  pushSubscriptions       PushSubscription[]
  pushLogs                PushNotificationLog[]
  pushSettings            PushSettings?
  whatsAppNotifications   WhatsAppNotification[]
  whatsAppInboundMessages WhatsAppInboundMessage[]
  studentCustomFields     StudentCustomField[]
  evaluations             Evaluation[]

  @@map("dojos")
}

// ── Organizations / federations the dojo belongs to ─────────
model DojoOrganization {
  id     String @id @default(cuid())
  dojoId String @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  name    String
  logoUrl String? @map("logo_url") @db.Text // Cloudinary URL
  order   Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([dojoId])
  @@map("dojo_organizations")
}

// ── Public website content for each dojo ────────────────────
model DojoPage {
  id     String @id @default(cuid())
  dojoId String @unique @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  published Boolean @default(false)

  // Hero section
  heroTitle    String? @map("hero_title")
  heroSubtitle String? @map("hero_subtitle")
  heroImage    String? @map("hero_image") @db.Text // Cloudinary URL — fondo del hero

  // About section
  aboutText  String? @map("about_text") @db.Text
  aboutImage String? @map("about_image") @db.Text // Cloudinary URL

  // Theme
  primaryColor String @default("#C0392B") @map("primary_color")

  // Visibility toggles
  showFreeTrial Boolean @default(true) @map("show_free_trial")
  showSchedules Boolean @default(true) @map("show_schedules")
  showContact   Boolean @default(true) @map("show_contact")
  showStore     Boolean @default(false) @map("show_store")

  // Ubicación
  address String? @db.Text // dirección física del dojo

  // Galería de atletas — array JSON de URLs Cloudinary
  galleryImages Json? @map("gallery_images")

  // Perfil del Sensei {name, rank, experience, bio, photo}
  sensei Json?

  // Barra de estadísticas [{value:"150+", label:"Alumnos formados"}, ...]
  stats Json?

  // Testimonios [{name, role, quote, photo?}, ...]
  testimonials Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dojo_pages")
}

// ── Free trial / scholarship requests ───────────────────────
model FreeTrialRequest {
  id     String @id @default(cuid())
  dojoId String @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  // Child info
  childName String @map("child_name")
  childAge  Int    @map("child_age")

  // Parent / guardian
  parentName  String  @map("parent_name")
  parentPhone String  @map("parent_phone")
  parentEmail String? @map("parent_email")
  message     String? @db.Text

  // Status flow: pending → contacted → scheduled → enrolled | cancelled
  status String @default("pending")

  // Assigned schedule (set by admin after review)
  scheduleId String?   @map("schedule_id")
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  read  Boolean @default(false) // admin has seen it
  notes String? @db.Text // admin internal notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dojoId])
  @@index([dojoId, status])
  @@index([dojoId, read])
  @@map("free_trial_requests")
}

// ── CRM Superadmin — "Primera Etapa": activación y riesgo básico ─────
// Registro de cada mensaje de seguimiento (automático o manual) enviado
// a un dojo-cliente por Cristhian/Superadmin. NO tiene dojoId de aislamiento
// multi-tenant en el sentido normal — este dojoId identifica AL CLIENTE
// destinatario, no un contexto de datos internos del dojo. Vive fuera del
// alcance de getEffectiveDojoId() a propósito: solo lo usa el panel Superadmin.
model DojoLifecycleMessage {
  id     String @id @default(cuid())
  dojoId String @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id], onDelete: Cascade)

  // "WELCOME" | "HELP_NO_STUDENTS" | "FOLLOWUP" | "LAST_ATTEMPT" | "REACTIVATION" | "MANUAL"
  type String

  // "whatsapp" | "manual" (contacto directo de Cristhian, registrado a mano)
  channel      String  @default("whatsapp")
  templateName String? @map("template_name")

  // "PENDING" | "SENT" | "DELIVERED" | "READ" | "FAILED" — igual semántica que WhatsAppNotification.
  // DELIVERED/READ los actualiza el webhook de WhatsApp vía metaMessageId (ver handleStatusUpdate).
  status         String  @default("PENDING")
  recipientPhone String? @map("recipient_phone")
  errorDetail    String? @map("error_detail") @db.Text

  // ID del mensaje en Meta — permite recibir actualizaciones de entregado/leído
  // por el webhook. Solo se llena cuando el envío real (send-pending) tuvo éxito.
  metaMessageId String? @unique @map("meta_message_id")

  // Nota libre — usada tanto para contacto manual como para contexto de un envío automático
  note String? @db.Text

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now())

  @@index([dojoId])
  @@index([dojoId, type])
  @@index([type, status])
  @@map("dojo_lifecycle_messages")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String
  role               String   @default("user") // sysadmin, admin, user, student
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  photo String? @db.Text

  dojoId String? @map("dojo_id")
  dojo   Dojo?   @relation(fields: [dojoId], references: [id])

  studentId String?  @unique @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id])

  resetToken        String?            @map("reset_token")
  resetTokenExpiry  DateTime?          @map("reset_token_expiry")
  pushSubscriptions PushSubscription[]

  lastSeenNewsAt  DateTime? @map("last_seen_news_at")
  lastActiveAt    DateTime? @map("last_active_at")
  lastVisitedPage String?   @map("last_visited_page")

  @@index([email])
  @@index([dojoId])
  @@index([dojoId, active])
  @@index([dojoId, role])
  @@map("users")
}

model Student {
  id          String  @id @default(cuid())
  studentCode Int?    @unique
  cardToken   String? @unique @map("card_token") // token impredecible para /id/[code] (carnet público)

  dojoId String @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id])

  fullName    String   @default("") @map("full_name")
  firstName   String
  lastName    String
  cedula      String?
  fepakaId    String?  @map("fepaka_id")
  ryoBukaiId  String?  @map("ryo_bukai_id")
  photo       String?  @db.Text
  birthDate   DateTime
  gender      String
  nationality String

  condition           String?
  bloodType           String? @map("blood_type")
  hasPrivateInsurance Boolean @default(false)
  insuranceName       String?
  insuranceNumber     String? @map("insurance_number")

  motherName  String?
  motherPhone String?
  motherEmail String?

  fatherName  String?
  fatherPhone String?
  fatherEmail String?

  primaryGuardian String? @map("primary_guardian") // "mother" | "father" — acudiente principal para acceso al portal

  // Consentimiento explícito para notificaciones de WhatsApp (mensualidad atrasada,
  // confirmación de pago). Se envía solo al acudiente principal (primaryGuardian).
  whatsappOptIn     Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInDate DateTime? @map("whatsapp_opt_in_date")

  address  String? @db.Text
  familyId String? @map("family_id")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Absence risk level — updated when attendance is recorded or via batch recalculation.
  // ACTIVO  : attended within last 3 days
  // ALERTA  : 3–13 days without attendance  (risk of disengagement)
  // RIESGO  : 14+ days without attendance  (high dropout risk)
  attendanceStatus String @default("ACTIVO") @map("attendance_status")

  portalUser               User?
  inscription              Inscription?
  payments                 Payment[]
  beltHistory              BeltHistory[]
  attendances              Attendance[]
  studentSchedules         StudentSchedule[]
  kataCompetitions         KataCompetition[]
  kataRankingAssignments   KataRankingAssignment[]
  tournamentParticipations TournamentParticipant[]
  tournamentRegistrations  TournamentRegistration[]
  eventRsvps               EventRSVP[]
  examInvitees             ExamApplicationInvitee[]
  certificates             GeneratedCertificate[]
  termsAcceptances         TermsAcceptance[]
  pushSubscriptions        PushSubscription[]
  storePurchaseRequests    StorePurchaseRequest[]
  whatsAppNotifications    WhatsAppNotification[]
  whatsAppInboundMessages  WhatsAppInboundMessage[]
  customFieldValues        StudentCustomFieldValue[]

  @@index([dojoId, active])
  @@index([dojoId, lastName, firstName])
  @@index([dojoId, fullName])
  @@index([dojoId, active, fullName])
  @@index([familyId])
  @@map("students")
}

// ── Campos personalizados del alumno ─────────────────────────────────────
// Para organizaciones/federaciones distintas a FEPAKA/Ryo Bukai (que ya
// tienen sus propios campos fijos — ver Dojo.showFepakaField/showRyoBukaiField).
// Un dojo que use FEPAKA o Ryo Bukai debe activar esos campos existentes,
// no crear uno personalizado con el mismo nombre.
model StudentCustomField {
  id        String   @id @default(cuid())
  dojoId    String   @map("dojo_id")
  dojo      Dojo     @relation(fields: [dojoId], references: [id], onDelete: Cascade)
  label     String // ej. "ID Federación Nacional"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  values StudentCustomFieldValue[]

  @@index([dojoId])
  @@map("student_custom_fields")
}

model StudentCustomFieldValue {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fieldId   String   @map("field_id")
  field     StudentCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, fieldId])
  @@index([fieldId])
  @@map("student_custom_field_values")
}

model Inscription {
  id        String  @id @default(cuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  inscriptionDate   DateTime
  annualPaymentDate DateTime?

  annualAmount   Float   @default(0)
  monthlyAmount  Float   @default(0)
  discountAmount Float   @default(0)
  discountNote   String?

  // Pago quincenal (cada 15 días — 1° y 15 de cada mes)
  // paymentPeriod defaults to "monthly" so existing students are unaffected.
  paymentPeriod  String @default("monthly") @map("payment_period") // monthly | biweekly
  biweeklyAmount Float  @default(0) @map("biweekly_amount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inscriptions")
}

model Payment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type     String
  amount   Float
  dueDate  DateTime
  paidDate DateTime?

  status       String  @default("pending")
  note         String?
  reminderSent Boolean @default(false)

  // Vínculo opcional cuando el cargo se generó automáticamente al confirmar
  // un evento con precio o una postulación a examen con costo — sin FK formal
  // (mismo criterio que TournamentEvent.sourceEventId), solo para poder
  // encontrar/cancelar el cargo si el alumno cambia de opinión.
  eventId       String? @map("event_id")
  examInviteeId String? @map("exam_invitee_id")

  // Token público impredecible para /pagar/[token] (página informativa enlazada
  // desde el botón del template de WhatsApp de atraso) — se genera on-demand.
  payToken String? @unique @map("pay_token")

  createdAt DateTime @default(now())

  whatsAppNotifications WhatsAppNotification[]

  @@unique([studentId, type, dueDate])
  @@index([studentId])
  @@index([studentId, status, dueDate])
  @@index([status, dueDate])
  @@index([reminderSent, status, dueDate])
  // Únicos separados de (studentId, type, dueDate) — ese triple puede
  // colisionar entre dos eventos/exámenes distintos que caigan en la misma
  // fecha para el mismo alumno (dueDate normalmente es medianoche). Estos
  // dos garantizan un solo cargo por evento o por postulación sin ese riesgo,
  // y permiten upsert atómico en vez de find-then-create (evita condición de carrera).
  @@unique([eventId, studentId])
  @@unique([examInviteeId])
  @@index([eventId])
  @@index([examInviteeId])
  @@map("payments")
}

model Kata {
  id          String   @id @default(cuid())
  name        String
  // Opcional — las katas de tipo "Kata de Competencias" no llevan cinta
  // asociada, se asignan directo a alumnos vía KataRankingAssignment.
  beltColor   String?
  order       Int      @default(0)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  dojoId String @map("dojo_id")
  dojo   Dojo   @relation(fields: [dojoId], references: [id])

  beltHistory        BeltHistory[]
  kataCompetitions   KataCompetition[]
  rankingAssignments KataRankingAssignment[]

  @@unique([name, dojoId])
  @@index([dojoId])
  @@index([beltColor])
  @@index([dojoId, active]) // GET /api/katas?active=1 filtered by dojo
  @@map("katas")
}

// Asignación de una Kata de Competencia (sin cinta) a uno o varios alumnos —
// "Kata de Ranking" en la UI. Distinto de KataCompetition, que es el
// historial de participaciones/resultados ya ocurridos en un torneo puntual;
// esto es "a qué alumnos les toca practicar esta kata ahora mismo".
model KataRankingAssignment {
  id        String   @id @default(cuid())
  kataId    String   @map("kata_id")
  kata      Kata     @relation(fields: [kataId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kataId, studentId])
  @@index([kataId])
  @@index([studentId])
  @@map("kata_ranking_assignments")
}

model BeltHistory {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  beltColor  String
  changeDate DateTime
  kataId     String?
  kata       Kata?    @relation(fields: [kataId], references: [id])
  kataIds    Json?    @map("kata_ids") // array de hasta 5 IDs para cintas roja–negra-3-dan
  isRanking  Boolean  @default(false)
  notes      String?

  createdAt DateTime @default(now())

  @@index([studentId, changeDate])
  @@index([isRanking, studentId])
  @@map("belt_history")
}

model Schedule {
  id                String             @id @default(cuid())
  dojoId            String             @map("dojo_id")
  dojo              Dojo               @relation(fields: [dojoId], references: [id])
  name              String
  days              String
  startTime         String
  endTime           String
  description       String?
  active            Boolean            @default(true)
  availableForTrial Boolean            @default(false) @map("available_for_trial")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendances       Attendance[]
  studentSchedules  StudentSchedule[]
  freeTrials        FreeTrialRequest[]

  @@index([dojoId])
  @@index([dojoId, active])
  @@map("schedules")
}

model Attendance {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  type        String
  markedAt    DateTime  @default(now())
  note        String?
  corrected   Boolean   @default(false)
  correctedBy String?
  createdAt   DateTime  @default(now())

  @@index([studentId, markedAt])
  @@index([scheduleId, markedAt])
  @@index([studentId, type, markedAt]) // duplicate-entry check: WHERE studentId=? AND type=? AND markedAt >= ?
  @@map("attendances")
}

model StudentSchedule {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  @@index([studentId])
  @@index([scheduleId])
  @@index([assignedAt])
  @@index([studentId, removedAt]) // active assignments: WHERE studentId=? AND removedAt IS NULL
  @@map("student_schedules")
}

model AuditLog {
  id String @id @default(cuid())

  // ── Qué se hizo ─────────────────────────────────────────────
  action       String // LOGIN_FAILED | STUDENT_CREATED | PAYMENT_MARKED_PAID | ...
  module       String? // AUTH | STUDENTS | PAYMENTS | BELTS | ATTENDANCE | USERS | SETTINGS | SYSADMIN | TOURNAMENTS | PORTAL
  method       String? // GET | POST | PUT | PATCH | DELETE
  resourceType String? @map("resource_type") // Student | User | Payment | BeltHistory | Dojo | Tournament
  resourceId   String? @map("resource_id") // ID del registro afectado
  statusCode   Int?    @map("status_code") // Código HTTP del resultado: 200 | 201 | 400 | 401 | 403 | 500

  // ── Quién lo hizo ────────────────────────────────────────────
  userId          String?
  userName        String? @map("user_name") // Nombre del actor
  userEmail       String?
  isSysadminProxy Boolean @default(false) @map("is_sysadmin_proxy") // sysadmin operando en dojo ajeno

  // ── Dónde ────────────────────────────────────────────────────
  dojoId   String?
  dojoSlug String?

  // ── Sobre quién / qué ────────────────────────────────────────
  targetId    String? @map("target_id") // ID del usuario o recurso objetivo
  targetEmail String? @map("target_email") // Email del objetivo (acciones sobre usuarios)

  // ── Red, dispositivo y geolocalización ───────────────────────
  ip        String?
  userAgent String? @db.Text
  country   String? // Código ISO del país (ES, PA, CO) via headers Vercel/Cloudflare
  city      String? // Ciudad del usuario
  region    String? // Región/estado

  // ── Sesión y correlación ──────────────────────────────────────
  sessionId String? @map("session_id") // UUID fijo por sesión — correlaciona todos los eventos del mismo login

  // ── Rendimiento y contexto ───────────────────────────────────
  duration Int? // Duración de la operación en ms
  details  String? @db.Text // JSON: { before, after, reason, extra }

  // ── Integridad ────────────────────────────────────────────────
  hash String? @db.Text // SHA-256 de los campos clave — detecta tampering del log

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([resourceType, resourceId])
  @@index([ip])
